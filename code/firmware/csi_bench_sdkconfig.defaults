# Target: classic ESP32 (ESP32-D0WD-V3, WROOM-class, NO PSRAM), 4 MB flash.
# The benchmark never uses WiFi/BT, so disable them to free internal DRAM for the
# tensor arena (recovers tens of kB of contiguous RAM on this PSRAM-less chip).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n
CONFIG_ESP_COEX_ENABLED=n
# TFLite-Micro AllocateTensors needs far more stack than the ~3.5 kB default;
# without this the interpreter overflows the main-task stack (InstrFetchProhibited).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
